<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RoboCamHub.Application;assembly=RoboCamHub.Application"
        x:Class="RoboCamHub.App.CameraElementPickerWindow"
        Width="420" Height="190" CanResize="False" Background="#111820"
        Title="Add camera element">
    <Grid RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="14">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Choose camera" />
        <ComboBox x:Name="CameraPicker" Grid.Row="1" PlaceholderText="Select camera">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CameraItemViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="10">
            <Button Padding="18,8" Content="Cancel" Click="OnCancel"/>
            <Button Padding="18,8" Content="Add" Click="OnAdd"/>
        </StackPanel>
    </Grid>
</Window>
