<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RoboCamHub.App.SaveChangesWindow"
        Width="500"
        Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Unsaved changes">
    <Grid RowDefinitions="*,Auto" Margin="24" RowSpacing="20">
        <StackPanel Spacing="10">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Save changes?" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Don't Save" Click="OnDontSave" />
            <Button Content="Save" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
