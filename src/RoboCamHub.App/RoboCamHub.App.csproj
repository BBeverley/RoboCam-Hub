<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RoboCam-Hub</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NativeSourceDirectory>$(MSBuildProjectDirectory)/../../native</NativeSourceDirectory>
    <NativeBuildDirectory>$(BaseIntermediateOutputPath)native/$(Configuration)</NativeBuildDirectory>
    <NativeConfigureArguments>-DBUILD_TESTING=OFF -DRCH_BUILD_INGEST_PROBE=OFF -DRCH_BUILD_NDI_PROBE=OFF</NativeConfigureArguments>
    <NativeConfigureArguments Condition="'$(RchPackageWithoutNdi)' == 'true'">$(NativeConfigureArguments) -DRCH_ENABLE_NDI_SDK=OFF</NativeConfigureArguments>
    <NativeConfigureArguments Condition="'$(OS)' != 'Windows_NT'">$(NativeConfigureArguments) -DCMAKE_BUILD_TYPE=$(Configuration)</NativeConfigureArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoboCamHub.Application\RoboCamHub.Application.csproj" />
    <ProjectReference Include="..\RoboCamHub.Persistence\RoboCamHub.Persistence.csproj" />
    <ProjectReference Include="..\RoboCamHub.Licensing\RoboCamHub.Licensing.csproj" />
  </ItemGroup>

  <Target Name="BuildAndStageNativeLibrary" BeforeTargets="Build">
    <Exec Command="cmake -S &quot;$(NativeSourceDirectory)&quot; -B &quot;$(NativeBuildDirectory)&quot; $(NativeConfigureArguments)" />
    <Exec Command="cmake --build &quot;$(NativeBuildDirectory)&quot; --config $(Configuration) --parallel" />

    <ItemGroup>
      <_AppNativeLibrary Include="$(NativeBuildDirectory)/**/robocamhub_native.dll" />
      <_AppNativeLibrary Include="$(NativeBuildDirectory)/**/librobocamhub_native.dylib" />
      <_AppNativeLibrary Include="$(NativeBuildDirectory)/**/librobocamhub_native.so" />
    </ItemGroup>

    <Error Condition="'@(_AppNativeLibrary)' == ''"
           Text="The native RoboCam Hub library was not produced for the application." />
    <Copy SourceFiles="@(_AppNativeLibrary)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageNativeLibraryForPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedNativeLibrary Include="$(NativeBuildDirectory)/**/robocamhub_native.dll" />
      <_PublishedNativeLibrary Include="$(NativeBuildDirectory)/**/librobocamhub_native.dylib" />
      <_PublishedNativeLibrary Include="$(NativeBuildDirectory)/**/librobocamhub_native.so" />
    </ItemGroup>

    <Error Condition="'@(_PublishedNativeLibrary)' == ''"
           Text="The native RoboCam Hub library was not available for publish." />
    <Copy SourceFiles="@(_PublishedNativeLibrary)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
